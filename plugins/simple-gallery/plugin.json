    { "id": "theme", "type": "choice", "label": { "en": "Theme", "pt-BR": "Tema" }, "default": "light",
      "choices": [ { "value": "light", "label": { "en": "Light", "pt-BR": "Claro" } }, { "value": "dark", "label": { "en": "Dark", "pt-BR": "Escuro" } } ] },
    { "id": "showDetails", "type": "bool", "label": { "en": "Show date and camera", "pt-BR": "Mostrar data e câmera" }, "default": true }
  ]
}
